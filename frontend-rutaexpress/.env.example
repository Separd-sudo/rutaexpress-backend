# URL base del Backend-For-Frontend (BFF)
VITE_BFF_URL=http://localhost:8080

# Credenciales de Azure Active Directory (Microsoft Entra ID)
# Opcional en desarrollo local, obligatorio para autenticacion real en la nube
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Configuracion de AWS Cognito (Federacion OIDC)
VITE_COGNITO_DOMAIN=https://<tu-dominio>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<tu-app-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/